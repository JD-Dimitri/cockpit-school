<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>PLANE SIMULATOR - {{ title }}</title>
<style>
  @page { margin: 16mm 14mm; }
  body { font-family: 'DejaVu Sans', sans-serif; font-size: 10.5pt; color: #111; line-height: 1.45; }
  header { border-bottom: 2px solid #0a5c8a; margin-bottom: 12pt; }
  header p { margin: 2pt 0; color: #444; }
  h1 { font-size: 18pt; margin: 4pt 0; }
  h2 { font-size: 14pt; color: #0a5c8a; margin: 16pt 0 6pt; }
  h3 { font-size: 11.5pt; margin: 12pt 0 4pt; }
  .mod { page-break-before: always; }
  .mod.first { page-break-before: auto; }
  table { border-collapse: collapse; }
  td, th { border: 1px solid #999; padding: 2pt 5pt; }
  img, svg { max-width: 100%; }
  .q { page-break-inside: avoid; margin-bottom: 6pt; }
  .q p { margin: 0 0 2pt; font-weight: bold; }
  .q ul { list-style: none; margin: 0; padding-left: 8pt; }
  .corr { border: 1px dashed #888; padding: 6pt 8pt; margin-top: 8pt; font-size: 9.5pt; }
  .note { font-size: 8pt; color: #555; }
</style>
</head>
<body>
<header>
  <p>PLANE SIMULATOR · Académie</p>
  <h1>{{ title }}</h1>
  {% if single %}<p>{{ part.n }}</p>{% endif %}
  <p class="note">Document pédagogique. Ne remplace pas un manuel de vol approuvé ni l'enseignement d'un instructeur.</p>
</header>
{% set L = ['A','B','C','D','E','F','G','H'] %}
{% for m in mods %}
<section class="mod{{ loop.first ? ' first' : '' }}">
  <h2>{{ m.t }}</h2>
  {# Contenu rédigé dans le projet (data/academy.json), rendu sans ressource extérieure. #}
  <div>{{ m.h|raw }}</div>
  {% if m.quiz is defined and m.quiz|length > 0 %}
    <h3>Exercices · QCM ({{ m.quiz|length }} questions)</h3>
    <ol>
      {% for q in m.quiz %}
        <li class="q"><p>{{ q.q }}</p>
          <ul>{% for o in q.o %}<li><b>{{ L[loop.index0] }}.</b> {{ o }}</li>{% endfor %}</ul>
        </li>
      {% endfor %}
    </ol>
    <div class="corr">
      <h3>Corrigé</h3>
      <ol>
        {% for q in m.quiz %}
          <li><b>{{ L[q.c] }}. {{ q.o[q.c] }}</b>{% if q.why is defined and q.why %} — {{ q.why|raw }}{% endif %}</li>
        {% endfor %}
      </ol>
    </div>
  {% endif %}
</section>
{% endfor %}
</body>
</html>
