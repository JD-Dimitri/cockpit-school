<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="vendor/autoload.php">
    <php>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="KERNEL_CLASS" value="App\Kernel"/>
        <server name="APP_SECRET" value="test"/>
        <server name="MAILER_DSN" value="null://null"/>
        <server name="FRONT_URL" value="http://localhost/"/>
        <server name="MAILER_FROM" value="test@example.org"/>
        <server name="TRAFIC_RECEPTEUR_JETON" value="jeton-de-test-0123456789abcdef"/>
    </php>
    <testsuites>
        <testsuite name="API">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
