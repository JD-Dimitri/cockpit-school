# Valeurs par défaut versionnées. Les secrets réels vont dans .env.local (non versionné) ou dans
# les variables d'environnement de l'hébergement (o2switch).
APP_ENV=dev
APP_SECRET=a-remplacer-dans-env-local

# Base de données (o2switch : MySQL / MariaDB). Exemple :
# DATABASE_URL="mysql://utilisateur:motdepasse@127.0.0.1:3306/plane_simulator?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"

# Envoi des e-mails (lien de réinitialisation). « null://null » n'envoie rien.
MAILER_DSN=null://null
MAILER_FROM="COCKPIT SCHOOL - PLANE SIMULATOR <no-reply@example.com>"

# Adresse publique de l'interface React (lien envoyé par e-mail).
FRONT_URL=http://localhost:8000/

# ---- Trafic réel (GET /api/trafic) : aucune source active par défaut. Activer dans .env.local. ----
# Récepteur ADS-B personnel (Raspberry Pi) : jeton secret partagé avec tools/recepteur/envoi_trafic.py
# (24 caractères au moins ; par exemple : php -r 'echo bin2hex(random_bytes(24));').
TRAFIC_RECEPTEUR_JETON=
# OpenSky Network : 1 pour activer. Identifiants OAuth2 facultatifs (sans eux : accès anonyme, 400 crédits par jour).
# Usage non commercial seulement, sauf accord avec OpenSky.
TRAFIC_OPENSKY_ACTIVE=0
TRAFIC_OPENSKY_CLIENT_ID=
TRAFIC_OPENSKY_CLIENT_SECRET=
# Flightradar24 (API officielle, abonnement payant) : clé du portail fr24api.flightradar24.com.
# Vérifier la licence de l'abonnement (affichage public, usage commercial) avant de la renseigner.
TRAFIC_FR24_CLE=
